{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "next/link": [
        "src/components/ui/Link.tsx"
      ],
      "next/image": [
        "src/components/ui/Image.tsx"
      ],
      "next/navigation": [
        "src/components/ui/Navigation.ts"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs"
  ]
}
