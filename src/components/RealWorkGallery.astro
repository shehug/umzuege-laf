---
import Image from "@/components/ui/Image";

interface GalleryItem {
  src: string;
  alt: string;
  title: string;
  location: string;
}

const items: GalleryItem[] = [
  {
    src: "/images/services/PU1.webp",
    alt: "Umzugshelfer von Umzüge LAF beim sicheren Möbeltransport in einer Landshuter Wohnung",
    title: "Privatumzug & Möbeltransport",
    location: "Landshut Achdorf",
  },
  {
    src: "/images/services/GU1.webp",
    alt: "Firmenumzug und Büromöbelmontage durch Umzüge LAF in Landshut",
    title: "Büro- & Praxisumzug",
    location: "Gewerbegebiet Landshut",
  },
  {
    src: "/images/services/Montage.webp",
    alt: "Fachgerechte Küchen- und Schrankmontage beim Umzug in Landshut",
    title: "Möbel- & Küchenmontage",
    location: "Landshut Wolfgang",
  },
  {
    src: "/images/services/Transport.webp",
    alt: "Umzugswagen von Umzüge LAF beim Privatumzug in Landshut",
    title: "Möbelwagen beladen & sichern",
    location: "Landshut Nikola",
  },
  {
    src: "/images/services/Express.webp",
    alt: "Transporter von Umzüge LAF für Kleintransporte und Expressumzüge in Landshut",
    title: "Kleintransport & Expressumzug",
    location: "Ergolding & Landshut",
  },
  {
    src: "/images/services/umzuege-laf-1.webp",
    alt: "Eingespieltes Team von Umzüge LAF bei einem Seniorenumzug in Landshut",
    title: "Seniorenumzug Full-Service",
    location: "Landshut Schönbrunn",
  },
];
---

<section class="py-16 sm:py-24 bg-slate-900 text-white border-t border-slate-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-400/10 px-3.5 py-1 text-xs font-bold text-amber-300">
          <span>📷 Echte Einsätze vor Ort</span>
        </div>
        <h2 class="mt-3 text-2xl sm:text-4xl font-black tracking-tight text-white">
          Einblicke in unsere Einsätze in Landshut &amp; Umgebung
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-300 max-w-2xl">
          Keine anonymen Bildagenturen, sondern echte Arbeit: Sehen Sie hier Impressionen unserer täglichen Umzüge, Montagearbeiten und Räumungen in der Region Landshut.
        </p>
      </div>

      <a
        href="/ueber-uns"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-amber-400 hover:text-amber-300 transition shrink-0"
      >
        <span>Mehr über unser Team erfahren</span>
        <span>→</span>
      </a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div
          key={item.title}
          class="group relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 shadow-md transition duration-300 hover:-translate-y-1 hover:border-amber-400/60 hover:shadow-xl"
        >
          <div class="relative h-56 w-full overflow-hidden bg-slate-800">
            <Image
              src={item.src}
              alt={item.alt}
              fill
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              class="object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent opacity-80" />
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
              <span class="rounded-md bg-amber-400/90 px-2 py-0.5 text-[11px] font-black text-slate-950">
                {item.location}
              </span>
            </div>
          </div>
          <div class="p-4">
            <p class="text-sm font-black text-white group-hover:text-amber-300 transition-colors">
              {item.title}
            </p>
            <p class="mt-1 text-xs text-slate-400 leading-relaxed">
              {item.alt}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

