---
const phone = "0162 900 75 65";
const phoneHref = "tel:+491629007565";

const navItems = [
  { label: "Startseite", href: "/" },
  {
    label: "Umzüge",
    href: "/umzugsunternehmen-landshut",
    children: [
      { label: "Umzugsunternehmen Landshut", href: "/umzugsunternehmen-landshut" },
      { label: "Umzugskosten & Rechner", href: "/umzugskosten-landshut" },
      { label: "Privatumzug", href: "/privatumzug-landshut" },
      { label: "Seniorenumzug", href: "/seniorenumzug-landshut" },
      { label: "Kleintransporte", href: "/kleintransporte-landshut" },
      { label: "Firmenumzug", href: "/firmenumzug-landshut" },
      { label: "Fernumzug", href: "/umzuege/fernumzug" },
      { label: "Expressumzug", href: "/umzuege/expressumzug" },
    ],
  },
  {
    label: "Entrümpelung",
    href: "/entruempelung-landshut",
    children: [
      { label: "Entrümpelung Landshut", href: "/entruempelung-landshut" },
      { label: "Wohnungsauflösung", href: "/wohnungsaufloesung-landshut" },
      { label: "Haushaltsauflösung", href: "/entruempelung/haushaltsaufloesung" },
      { label: "Kellerentrümpelung", href: "/entruempelung/kellerentruempelung" },
      { label: "Sperrmüllentsorgung", href: "/entruempelung/sperrmuellentsorgung" },
    ],
  },
  {
    label: "Service",
    href: "/leistungen",
    children: [
      { label: "Alle Leistungen", href: "/leistungen" },
      { label: "Umzugskostenrechner", href: "/umzugskosten-landshut" },
      { label: "Möbelmontage", href: "/umzuege/moebelmontage" },
      { label: "Einpackservice", href: "/umzuege/einpackservice" },
      { label: "Lagerung", href: "/umzuege/lagerung" },
      { label: "Häufige Fragen (FAQ)", href: "/faq" },
    ],
  },
  { label: "Über uns", href: "/ueber-uns" },
  { label: "Kontakt", href: "/kontakt" },
];
---

<header class="fixed left-0 top-0 z-50 w-full border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    {/* Logo */}
    <a href="/" class="flex items-center">
      <div class="relative h-10 w-28 sm:h-12 sm:w-36 transition hover:opacity-90">
        <picture style="display: contents;">
          <source srcset="/images/logo/laf-logo.webp" type="image/webp" />
          <img
            src="/images/logo/laf-logo.png"
            alt="Umzüge LAF Logo"
            class="h-full w-full object-contain"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        item.children ? (
          <div class="desktop-dropdown-group relative" data-dropdown-group>
            <button
              type="button"
              class="desktop-dropdown-btn flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-[14px] font-bold text-slate-700 transition hover:bg-slate-100 hover:text-slate-900 cursor-pointer"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span>{item.label}</span>
              <svg
                class="desktop-chevron h-3.5 w-3.5 text-slate-400 transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              class="desktop-dropdown-menu absolute left-1/2 top-full w-[280px] -translate-x-1/2 pt-2 z-50"
              data-dropdown-menu
            >
              <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl ring-1 ring-black/5">
                <div class="grid gap-0.5">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-[#fffbeb] hover:text-[#b45309]"
                    >
                      <span>{child.label}</span>
                      <span class="text-xs text-slate-400">→</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="flex items-center gap-1 rounded-lg px-3.5 py-2 text-[14px] font-bold text-slate-700 transition hover:bg-slate-100 hover:text-slate-900"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    {/* Action Header Controls */}
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={phoneHref}
        data-track="phone"
        data-track-loc="Header"
        class="flex items-center gap-2 rounded-full bg-[#f59e0b] px-4 py-2 text-xs font-black text-slate-900 shadow-sm transition hover:bg-[#d97706] hover:text-white sm:px-5 sm:py-2.5 sm:text-sm"
      >
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="hidden min-[480px]:inline">{phone}</span>
        <span class="min-[480px]:hidden">Anrufen</span>
      </a>

      <a
        href="/kontakt"
        class="hidden rounded-full border border-slate-300 bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-slate-800 sm:inline-flex sm:px-5 sm:py-2.5 sm:text-sm"
      >
        Angebot
      </a>

      {/* Mobile Hamburger */}
      <button
        id="mobile-menu-open-btn"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700 transition hover:bg-slate-100 lg:hidden cursor-pointer"
        aria-label="Menü öffnen"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Mobile Drawer */}
<div id="mobile-menu-drawer" class="hidden fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm lg:hidden">
  <div class="absolute inset-x-2 top-2 max-h-[calc(100vh-1rem)] overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-2xl">
    <div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-100 bg-white p-4">
      <a href="/" class="flex items-center">
        <div class="relative h-10 w-28">
          <picture style="display: contents;">
            <source srcset="/images/logo/laf-logo.webp" type="image/webp" />
            <img
              src="/images/logo/laf-logo.png"
              alt="Umzüge LAF Logo"
              class="h-full w-full object-contain"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
      </a>

      <button
        id="mobile-menu-close-btn"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-lg font-bold text-slate-700 transition hover:bg-slate-200 cursor-pointer"
        aria-label="Menü schließen"
      >
        ✕
      </button>
    </div>

    <nav class="grid gap-1.5 p-3">
      {navItems.map((item) => (
        <div class="overflow-hidden rounded-xl border border-slate-100 bg-slate-50">
          {item.children ? (
            <div>
              <button
                type="button"
                data-mobile-category
                class="flex w-full items-center justify-between px-4 py-3 text-left text-sm font-extrabold text-slate-800 transition hover:bg-slate-100 cursor-pointer"
              >
                <span>{item.label}</span>
                <span data-accordion-icon class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-200 text-xs font-bold">
                  +
                </span>
              </button>

              <div data-mobile-submenu class="hidden grid gap-1 border-t border-slate-100 bg-white p-2">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="flex items-center justify-between rounded-lg px-3.5 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-[#fffbeb] hover:text-[#b45309]"
                  >
                    <span>{child.label}</span>
                    <span class="text-xs text-slate-400">→</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="flex items-center justify-between px-4 py-3 text-sm font-extrabold text-slate-800 transition hover:bg-slate-100"
            >
              <span>{item.label}</span>
              <span class="text-xs text-slate-400">→</span>
            </a>
          )}
        </div>
      ))}
    </nav>

    <div class="grid grid-cols-2 gap-2 border-t border-slate-100 p-4">
      <a
        href={phoneHref}
        data-track="phone"
        data-track-loc="Mobile Menü"
        class="flex items-center justify-center gap-2 rounded-xl bg-[#f59e0b] py-3 text-center text-sm font-extrabold text-slate-900 shadow-sm"
      >
        <span>📞 Anrufen</span>
      </a>

      <a
        href="/kontakt"
        class="flex items-center justify-center rounded-xl bg-slate-900 py-3 text-center text-sm font-extrabold text-white shadow-sm"
      >
        Angebot anfordern
      </a>

      <a
        href="/kontakt?leistung=Besichtigung#anfrageformular"
        data-track="booking"
        data-track-loc="Mobile Menü Besichtigungsanfrage"
        class="col-span-2 flex items-center justify-center gap-2 rounded-xl border border-amber-400 bg-amber-50/70 py-3 text-center text-sm font-black text-slate-900 shadow-sm transition hover:bg-amber-100"
      >
        <span>📅 Besichtigung anfragen</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* Desktop Dropdown Styles */
  .desktop-dropdown-group {
    position: relative;
  }

  .desktop-dropdown-menu {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(4px);
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 160ms;
  }

  /* Invisible hover tunnel/bridge connecting button to menu so diagonal mouse movement never loses hover */
  .desktop-dropdown-menu::before {
    content: "";
    position: absolute;
    top: -12px;
    left: -20px;
    right: -20px;
    height: 16px;
    background: transparent;
  }

  /* Reliable opening: CSS hover, focus-within, and explicit JS is-open class (works on mouse, touch laptops, trackpads) */
  .desktop-dropdown-group:hover .desktop-dropdown-menu,
  .desktop-dropdown-group:focus-within .desktop-dropdown-menu,
  .desktop-dropdown-group.is-open .desktop-dropdown-menu {
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateX(-50%) translateY(0) !important;
  }

  .desktop-dropdown-group:hover .desktop-chevron,
  .desktop-dropdown-group:focus-within .desktop-chevron,
  .desktop-dropdown-group.is-open .desktop-chevron {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (function () {
    // ── 1. Desktop Navigation Dropdown Toggle & Click-Outside ──
    var desktopGroups = document.querySelectorAll(".desktop-dropdown-group");

    desktopGroups.forEach(function (group) {
      var btn = group.querySelector(".desktop-dropdown-btn");
      if (!btn) return;

      btn.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        var wasOpen = group.classList.contains("is-open");

        // Close any other open menus
        desktopGroups.forEach(function (other) {
          if (other !== group) {
            other.classList.remove("is-open");
            var otherBtn = other.querySelector(".desktop-dropdown-btn");
            if (otherBtn) otherBtn.setAttribute("aria-expanded", "false");
          }
        });

        if (wasOpen) {
          group.classList.remove("is-open");
          btn.setAttribute("aria-expanded", "false");
        } else {
          group.classList.add("is-open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    // Close desktop dropdowns on click outside
    document.addEventListener("click", function (e) {
      desktopGroups.forEach(function (group) {
        if (!group.contains(e.target)) {
          group.classList.remove("is-open");
          var btn = group.querySelector(".desktop-dropdown-btn");
          if (btn) btn.setAttribute("aria-expanded", "false");
        }
      });
    });

    // Close on Escape key
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        desktopGroups.forEach(function (group) {
          group.classList.remove("is-open");
          var btn = group.querySelector(".desktop-dropdown-btn");
          if (btn) btn.setAttribute("aria-expanded", "false");
        });
      }
    });

    // ── 2. Mobile Drawer & Accordion Logic ──
    var openBtn = document.getElementById("mobile-menu-open-btn");
    var closeBtn = document.getElementById("mobile-menu-close-btn");
    var drawer = document.getElementById("mobile-menu-drawer");

    function openMenu() {
      if (drawer) {
        drawer.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      }
    }

    function closeMenu() {
      if (drawer) {
        drawer.classList.add("hidden");
        document.body.style.overflow = "";
      }
    }

    if (openBtn) openBtn.addEventListener("click", openMenu);
    if (closeBtn) closeBtn.addEventListener("click", closeMenu);

    if (drawer) {
      drawer.addEventListener("click", function (e) {
        if (e.target === drawer) {
          closeMenu();
        } else if (e.target.tagName === "A" || e.target.closest("a")) {
          closeMenu();
        }
      });
    }

    // Mobile category accordions
    var categoryBtns = document.querySelectorAll("[data-mobile-category]");
    categoryBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var submenu = btn.parentElement.querySelector("[data-mobile-submenu]");
        var icon = btn.querySelector("[data-accordion-icon]");
        if (submenu) {
          var isHidden = submenu.classList.contains("hidden");
          if (isHidden) {
            submenu.classList.remove("hidden");
            if (icon) icon.textContent = "−";
          } else {
            submenu.classList.add("hidden");
            if (icon) icon.textContent = "+";
          }
        }
      });
    });
  })();
</script>
