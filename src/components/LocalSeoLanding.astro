---
import Header from "./Header";
import Footer from "./Footer";
import BreadcrumbJsonLd from "./BreadcrumbJsonLd";
import Breadcrumbs, { type BreadcrumbItem } from "./Breadcrumbs";
import ServiceJsonLd from "./ServiceJsonLd";
import ContactForm from "./ContactForm";

export type FaqItem = {
  q: string;
  a: string;
};

export type RelatedService = {
  title: string;
  text: string;
  href: string;
};

export interface Props {
  breadcrumbName: string;
  path: string;
  serviceName: string;
  serviceType: string;
  serviceDescription: string;
  badge: string;
  h1Top: string;
  h1Highlight: string;
  h1Bottom: string;
  intro: string;
  image: string;
  imageAlt: string;
  sectionKicker: string;
  sectionTitle: string;
  sectionText: string;
  benefits: string[];
  steps: {
    title: string;
    text: string;
  }[];
  relatedServices?: RelatedService[];
  faqs?: FaqItem[];
}

const {
  breadcrumbName,
  path,
  serviceName,
  serviceType,
  serviceDescription,
  badge,
  h1Top,
  h1Highlight,
  h1Bottom,
  intro,
  image,
  imageAlt,
  sectionKicker,
  sectionTitle,
  sectionText,
  benefits,
  steps,
  relatedServices = [],
  faqs = [],
} = Astro.props;

const phone = "0162 900 75 65";
const phoneHref = "tel:+491629007565";

let visualBreadcrumbs: BreadcrumbItem[] = [];
if (path.startsWith("/umzuege/")) {
  visualBreadcrumbs = [
    { label: "Umzüge", href: "/umzuege" },
    { label: breadcrumbName },
  ];
} else if (path.startsWith("/entruempelung/")) {
  visualBreadcrumbs = [
    { label: "Entrümpelung", href: "/entruempelung-landshut" },
    { label: breadcrumbName },
  ];
} else if (path.includes("umzug")) {
  visualBreadcrumbs = [
    { label: "Leistungen", href: "/leistungen" },
    { label: breadcrumbName },
  ];
} else {
  visualBreadcrumbs = [{ label: breadcrumbName }];
}

const jsonLdItems = [
  { name: "Startseite", path: "/" },
  ...visualBreadcrumbs.map((b) => ({ name: b.label, path: b.href || path })),
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<main class="min-h-screen bg-white text-slate-900">
  <Header client:load />

  <BreadcrumbJsonLd items={jsonLdItems} />

  <ServiceJsonLd
    name={serviceName}
    description={serviceDescription}
    path={path}
    serviceType={serviceType}
  />

  {faqs && faqs.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema).replace(/</g, "\\u003c")}
    />
  )}

  {/* ── HERO SECTION ── */}
  <section class="relative overflow-hidden bg-slate-950 pt-28 pb-16 text-white sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28">
    <div class="absolute inset-0 z-0 opacity-60">
      <img
        src={image}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 75vw, 1200px"
        class="h-full w-full object-cover object-center sm:object-right"
      />
    </div>
    <div class="absolute inset-0 z-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/30 sm:to-transparent"></div>
    <div class="absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        {/* Visual Breadcrumbs */}
        <Breadcrumbs items={visualBreadcrumbs} />

        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-400/10 px-3.5 py-1.5 text-xs font-extrabold text-amber-300">
          <span>★ 5.0 / 5 Bewertung ·</span>
          <span>{badge}</span>
        </div>

        <h1 class="text-3xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
          {h1Top}{" "}
          <span class="text-amber-400">{h1Highlight}</span>{" "}
          {h1Bottom}
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
          {intro}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
          <a
            href={phoneHref}
            class="flex items-center justify-center gap-2.5 rounded-full bg-[#f59e0b] px-7 py-4 text-center text-base font-black text-slate-950 shadow-lg transition hover:bg-amber-400 active:scale-98"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Direkt anrufen: {phone}</span>
          </a>

          <a
            href="#anfrage-formular"
            class="flex items-center justify-center rounded-full border-2 border-slate-600 bg-slate-800/80 px-7 py-4 text-center text-base font-bold text-white transition hover:border-slate-400 hover:bg-slate-700 active:scale-98"
          >
            Kostenlos anfragen →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── VORTEILE & DETAILS ── */}
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:px-8">
      <div>
        <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
          {sectionKicker}
        </p>

        <h2 class="mt-2 text-2xl sm:text-4xl font-black tracking-tight text-slate-900">
          {sectionTitle}
        </h2>

        <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600">
          {sectionText}
        </p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {benefits.map((item) => (
            <div
              class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3.5 shadow-sm sm:p-4"
            >
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-xs font-black text-amber-800">
                ✓
              </span>
              <p class="text-xs sm:text-sm font-bold text-slate-800">{item}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-xl">
        <div class="relative h-[320px] sm:h-[420px]">
          <img src={image} alt={imageAlt} class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 rounded-xl border border-white/20 bg-slate-900/80 p-5 text-white backdrop-blur-md">
            <h3 class="text-base font-black sm:text-lg">
              Persönlich geplant. Zuverlässig umgesetzt.
            </h3>
            <p class="mt-1 text-xs text-slate-300 leading-relaxed">
              Umzüge LAF unterstützt Sie in Landshut und Umgebung mit klarer
              Abstimmung, geschultem Team und fairer Festpreis-Kalkulation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4-SCHRITTE ABLAUF ── */}
  <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
          Ablauf
        </p>
        <h2 class="mt-2 text-2xl sm:text-4xl font-black tracking-tight text-slate-900">
          So einfach funktioniert die Zusammenarbeit
        </h2>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, index) => (
          <div
            class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
          >
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-sm font-black text-amber-800">
              {index + 1}
            </div>
            <h3 class="mt-3 text-base font-black text-slate-900">{step.title}</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-600">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── PASSENDE WEITERE LEISTUNGEN ── */}
  {relatedServices && relatedServices.length > 0 && (
    <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
            Weitere Services
          </p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
            Passende Leistungen rund um Umzug & Räumung
          </h2>
        </div>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedServices.map((service) => (
            <a
              href={service.href}
              class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm transition hover:border-amber-400 hover:bg-white hover:shadow-md"
            >
              <h3 class="text-base font-black text-slate-900 group-hover:text-[#b45309]">
                {service.title}
              </h3>
              <p class="mt-2 text-xs text-slate-600 leading-relaxed">{service.text}</p>
              <p class="mt-3 text-xs font-black text-[#b45309]">Mehr erfahren →</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── FAQ & ANFRAGE SEKTION ── */}
  <section class="py-16 sm:py-24 bg-slate-900 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {faqs && faqs.length > 0 && (
        <div class="mb-16">
          <p class="text-xs font-black uppercase tracking-widest text-amber-400">
            Fragen & Antworten
          </p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black text-white">
            Häufige Fragen zu {breadcrumbName}
          </h2>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {faqs.map((item) => (
              <div
                class="rounded-2xl border border-slate-800 bg-slate-800/60 p-5 shadow-sm"
              >
                <h3 class="text-sm sm:text-base font-black text-white">{item.q}</h3>
                <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-300">{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div id="anfrage-formular" class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center scroll-mt-20">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-400/10 px-3 py-1 text-xs font-bold text-amber-300">
            <span>📍</span>
            <span>Standort: Ergoldinger Str. 15, 84030 Landshut</span>
          </div>

          <h2 class="mt-4 text-3xl sm:text-4xl font-black text-white">
            Jetzt kostenloses Angebot anfordern
          </h2>

          <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
            Rufen Sie uns direkt an oder senden Sie uns Ihre Eckdaten. Wir
            erstellen Ihnen kurzfristig ein transparentes Festpreis-Angebot.
          </p>

          <div class="mt-6 rounded-2xl border border-slate-700 bg-slate-800/80 p-5">
            <p class="text-xs font-bold text-amber-400 uppercase tracking-wider">
              Telefonisch anfragen
            </p>
            <a
              href={phoneHref}
              class="mt-1 inline-flex items-center gap-2 text-xl font-black text-white hover:text-amber-400 transition"
            >
              <span>📞</span>
              <span>{phone}</span>
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-700 bg-white p-6 sm:p-8 text-slate-900 shadow-2xl">
          <h3 class="text-xl font-black text-slate-900">
            Online-Anfrage senden
          </h3>
          <p class="mt-1 text-xs text-slate-500">
            In 2 Minuten ausgefüllt – 100% unverbindlich.
          </p>
          <div class="mt-5">
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</main>
