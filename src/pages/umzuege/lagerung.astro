---
import Layout from "@/layouts/Layout.astro";
import LocalSeoLanding from "@/components/LocalSeoLanding.astro";
import { createSeoMetadata, seoPages } from "@/lib/seo";

const meta = createSeoMetadata(seoPages.lagerung);
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <LocalSeoLanding
      breadcrumbName="Lagerung Landshut"
      path="/umzuege/lagerung"
      serviceName="Möbellagerung Landshut"
      serviceType="Lagerung"
      serviceDescription="Möbellagerung und Zwischenlagerung in Landshut mit Umzüge LAF. Sicher, trocken und flexibel für Möbel, Hausrat und Kartons."
      badge="Sicher & Trocken"
      h1Top="Möbellagerung Landshut."
      h1Highlight="Sicher & trocken gelagert."
      h1Bottom="Flexibel buchbar."
      intro="Neue Wohnung noch nicht bezugsfertig oder Renovierung geplant? Umzüge LAF bietet sichere und trockene Zwischenlagerung für Ihre Möbel und Ihr Umzugsgut in Landshut."
      image="/images/services/Lagerung.jpg"
      imageAlt="Möbellagerung von Umzüge LAF in Landshut"
      sectionKicker="Lagerlösungen"
      sectionTitle="Ihr Hab und Gut in besten Händen."
      sectionText="Ob für wenige Wochen oder mehrere Monate: Wir holen Ihre Möbel auf Wunsch direkt bei Ihnen ab, verpacken sie staub- und feuchtigkeitsgeschützt und lagern sie in gesicherten, trockenen Räumlichkeiten."
      benefits={[
        "Trockene, saubere & sichere Lagerräume",
        "Abholung & Einlagerung aus einer Hand",
        "Flexible Mietzeiten (kurz- & langfristig)",
        "Fachgerechte Schutzverpackung",
        "Rücklieferung direkt an Ihre neue Adresse",
        "Transparente Monatspreise",
      ]}
      steps={[
        { title: "Lagermenge abstimmen", text: "Wir ermitteln den benötigten Raumbedarf für Ihre Möbel und Kartons." },
        { title: "Abholung & Schutz", text: "Unser Team holt das Lagergut ab und schützt es mit Schutzfolien und Decken." },
        { title: "Sichere Einlagerung", text: "Ihre Möbel lagern sicher und trocken für die vereinbarte Dauer." },
        { title: "Auslagerung & Lieferung", text: "Zum Wunschtermin liefern wir alles wieder an Ihren neuen Wohnort." },
      ]}
      relatedServices={[
        { title: "Privatumzug Landshut", text: "Wohnungsumzug mit Planung, Transport und Montage.", href: "/privatumzug-landshut" },
        { title: "Einpackservice", text: "Sorgfältiges Verpacken vor der Einlagerung.", href: "/umzuege/einpackservice" },
        { title: "Möbelmontage", text: "Fachgerechter Abbau vor der Lagerung und Wiederaufbau.", href: "/umzuege/moebelmontage" },
      ]}
      faqs={[
        { q: "Wie flexibel sind die Lagerzeiten?", a: "Sie können flexibel von wenigen Wochen bis zu mehreren Monaten oder Jahren lagern – genau so lange, wie Sie es benötigen." },
        { q: "Werden die Möbel vor Feuchtigkeit geschützt?", a: "Ja, alle Lagerräume sind trocken, beheizt und sauber. Zudem verpacken wir empfindliche Polster und Holzoberflächen mit Spezialfolien." },
        { q: "Können Sie die Möbel auch bei mir abholen?", a: "Ja! Wir bieten einen Rundum-Service: Wir holen die Möbel ab, lagern sie ein und liefern sie später wieder aus." },
      ]}
    />
</Layout>
