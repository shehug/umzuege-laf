---
import Layout from "@/layouts/Layout.astro";
import LocalSeoLanding from "@/components/LocalSeoLanding.astro";
import { createSeoMetadata, seoPages } from "@/lib/seo";

const meta = createSeoMetadata(seoPages.moebelmontage);
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <LocalSeoLanding
      breadcrumbName="Möbelmontage Landshut"
      path="/umzuege/moebelmontage"
      serviceName="Möbelmontage Landshut"
      serviceType="Möbelmontage"
      serviceDescription="Möbelmontage und Demontage in Landshut mit Umzüge LAF. Fachgerechter Aufbau von Schränken, Betten, Regalen und Möbeln beim Umzug."
      badge="Fachgerechter Möbelaufbau"
      h1Top="Möbelmontage Landshut."
      h1Highlight="Fachgerecht ab- & aufgebaut."
      h1Bottom="Ohne Stress."
      intro="Schränke, Betten, Regale oder Küchenmöbel: Umzüge LAF übernimmt die professionelle Demontage und den stabilen Wiederaufbau Ihrer Möbel in Landshut und Umgebung."
      image="/images/services/Montage.jpg"
      imageAlt="Möbelmontage von Umzüge LAF in Landshut"
      sectionKicker="Montageservice"
      sectionTitle="Sauber montiert, sicher transportiert."
      sectionText="Große Schränke, empfindliche Betten oder komplexe Regalsysteme erfordern Zeit, passendes Werkzeug und Erfahrung. Wir zerlegen Ihre Möbel fachgerecht, sichern alle Kleinteile und bauen sie am Zielort passgenau wieder auf."
      benefits={[
        "Fachgerechte Demontage & Montage",
        "Passendes Werkzeug immer dabei",
        "Sichere Verpackung empfindlicher Teile",
        "Aufbau direkt am Wunschplatz",
        "Kombinierbar mit jedem Umzug",
        "Faire Festpreise",
      ]}
      steps={[
        { title: "Möbel abstimmen", text: "Sie nennen uns die Möbelstücke, die montiert oder demontiert werden sollen." },
        { title: "Sorgfältige Demontage", text: "Wir zerlegen die Möbel transportsicher und beschriften alle Schrauben & Beschläge." },
        { title: "Sicherer Transport", text: "Alle Möbelteile werden geschützt und sicher im Transporter verstaut." },
        { title: "Fachgerechter Aufbau", text: "Am neuen Wohnort bauen wir Ihre Möbel stabil und millimetergenau auf." },
      ]}
      relatedServices={[
        { title: "Privatumzug Landshut", text: "Kompletter Wohnungsumzug inklusive Möbelmontage und Transport.", href: "/privatumzug-landshut" },
        { title: "Einpackservice", text: "Sorgfältiges Verpacken von Hausrat, Kleidung und Geschirr.", href: "/umzuege/einpackservice" },
        { title: "Umzugsunternehmen Landshut", text: "Unsere Hauptseite für alle Umzugsdienstleistungen in Landshut.", href: "/umzugsunternehmen-landshut" },
      ]}
      faqs={[
        { q: "Montieren Sie auch Schränke mit Schiebetüren?", a: "Ja, unser Team verfügt über jahrelange Erfahrung im Auf- und Abbau von komplexen Schiebetürenschränken und PAX-Systemen." },
        { q: "Bringen Sie das Werkzeug mit?", a: "Selbstverständlich! Unsere Monteure haben alle gängigen Werkzeuge, Akkuschrauber und Montagematerialien immer dabei." },
        { q: "Kann die Möbelmontage auch ohne Umzug gebucht werden?", a: "Ja, wir übernehmen auch reine Montagearbeiten oder das Umstellen größerer Möbel innerhalb eines Hauses." },
      ]}
    />
</Layout>
