---
import Layout from "@/layouts/Layout.astro";
import Image from "@/components/ui/Image";
import { createSeoMetadata, seoPages } from "@/lib/seo";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LocalSeoLinks from "@/components/LocalSeoLinks";
import ServiceJsonLd from "@/components/ServiceJsonLd";
import BreadcrumbJsonLd from "@/components/BreadcrumbJsonLd";
import Breadcrumbs from "@/components/Breadcrumbs";
import ContactForm from "@/components/ContactForm";

const phone = "0162 900 75 65";
const phoneHref = "tel:+491629007565";

const benefits = [
  {
    title: "Sorgfältiger Transport",
    text: "Möbel, Kartons und persönliche Gegenstände werden sicher und vorsichtig transportiert.",
  },
  {
    title: "Verlässliche Festpreise",
    text: "Wir klären Etagen, Umfang, Montage und Zeitfenster vorab sauber ab – ohne versteckte Kosten.",
  },
  {
    title: "Persönlicher Ansprechpartner",
    text: "Sie sprechen direkt mit uns und haben eine feste Bezugsperson vor Ort.",
  },
  {
    title: "Flexible Zusatzleistungen",
    text: "Auf Wunsch mit Einpackservice, Möbelmontage, Küchenabbau und Entsorgung.",
  },
];

const process = [
  {
    title: "Anfrage senden",
    text: "Startort, Zielort, Terminwunsch und ungefähren Umfang mitteilen.",
  },
  {
    title: "Festpreis erhalten",
    text: "Wir besprechen Etagen, Aufzug und Montage und erstellen Ihr Festpreis-Angebot.",
  },
  {
    title: "Pünktlich umziehen",
    text: "Unser eingespieltes Team transportiert Ihre Möbel zuverlässig an den neuen Wohnort.",
  },
];

const included = [
  "Wohnungsumzug & Hausumzug",
  "Möbeltransport & Tragearbeiten",
  "Fachgerechte Möbelmontage",
  "Einpackservice & Schutzverpackung",
  "Kurzfristige Termine nach Absprache",
  "Volle Transportversicherung",
];

const meta = createSeoMetadata({
  title: "Privatumzug Landshut » Stressfrei & zum Festpreis | Umzüge LAF",
  description:
    "Privatumzug in Landshut mit Umzüge LAF: Wohnungsumzug, Hausumzug, Möbeltransport, Möbelmontage, Einpackservice und persönliche Planung zum Festpreis.",
  path: "/privatumzug-landshut",
  keywords: [
    "Privatumzug Landshut",
    "Wohnungsumzug Landshut",
    "Hausumzug Landshut",
    "Umzug Wohnung Landshut",
    "Umzugsunternehmen Landshut",
  ],
  image: "https://umzuegelandshut.de/images/services/PU1.jpg",
});


---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <main class="min-h-screen bg-white text-slate-900">
      <Header />

      <BreadcrumbJsonLd
        items={[
          { name: "Startseite", path: "/" },
          { name: "Privatumzug Landshut", path: "/privatumzug-landshut" },
        ]}
      />

      <ServiceJsonLd
        name="Privatumzug Landshut"
        description="Privatumzug in Landshut mit Umzüge LAF. Zuverlässige Planung, sicherer Transport, Möbelmontage und saubere Umsetzung für Ihren Wohnungsumzug."
        path="/privatumzug-landshut"
        serviceType="Privatumzug"
      />

      {/* ── HERO ── */}
      <section class="relative overflow-hidden bg-slate-950 pt-28 pb-16 text-white sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28">
        <div class="absolute inset-0 z-0 opacity-60">
          <Image
            src="/images/services/PU1.jpg"
            alt="Umzüge LAF Privatumzug in Landshut"
            fill
            priority
            class="object-cover object-center sm:object-right"
          />
        </div>
        <div class="absolute inset-0 z-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/30 sm:to-transparent" />
        <div class="absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40" />

        <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <Breadcrumbs
              items={[
                { label: "Leistungen", href: "/leistungen" },
                { label: "Privatumzug Landshut" },
              ]}
            />

            <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-400/10 px-3.5 py-1.5 text-xs font-extrabold text-amber-300">
              <span>★ 5.0 / 5 Sterne ·</span>
              <span>Privatumzug Landshut & Umgebung</span>
            </div>

            <h1 class="text-3xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
              Privat umziehen in Landshut.<br />
              <span class="text-amber-400">Stressfrei & zum Festpreis.</span>
            </h1>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
              Ob Wohnung, Haus oder einzelner Möbeltransport: Umzüge LAF plant
              Ihren Privatumzug zuverlässig, sorgfältig und persönlich — von
              der ersten Kiste bis zum fertigen Aufbau.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
              <a
                href={phoneHref}
                class="flex items-center justify-center gap-2.5 rounded-full bg-[#f59e0b] px-7 py-4 text-center text-base font-black text-slate-950 shadow-lg transition hover:bg-amber-400 active:scale-98"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
                  <path strokeLinecap="round" strokeLinejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>Direkt anrufen: {phone}</span>
              </a>

              <a
                href="#anfrage-formular"
                class="flex items-center justify-center rounded-full border-2 border-slate-600 bg-slate-800/80 px-7 py-4 text-center text-base font-bold text-white transition hover:border-slate-400 hover:bg-slate-700 active:scale-98"
              >
                Kostenlos anfragen →
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* ── VORTEILE ── */}
      <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
              Ihre Vorteile
            </p>
            <h2 class="mt-2 text-2xl sm:text-4xl font-black tracking-tight text-slate-900">
              Warum Kunden ihren Privatumzug mit uns machen
            </h2>
          </div>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {benefits.map((b) => (
              <div
                key={b.title}
                class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm"
              >
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-sm font-black text-amber-800">
                  ✓
                </div>
                <h3 class="mt-4 text-base font-black text-slate-900">{b.title}</h3>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">{b.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── LEISTUNGSUMFANG ── */}
      <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
          <div>
            <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
              Leistungsumfang
            </p>
            <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
              Alles aus einer Hand für Ihr neues Zuhause
            </h2>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              Wir stimmen den Service genau auf Ihre Bedürfnisse ab. Sie entscheiden,
              welche Aufgaben Sie abgeben möchten.
            </p>

            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {included.map((item) => (
                <div key={item} class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm text-xs sm:text-sm font-bold text-slate-800">
                  <span class="text-amber-500 font-black">✓</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
            <h3 class="text-lg font-black text-slate-900">
              In 3 Schritten zu Ihrem Privatumzug
            </h3>
            <div class="mt-6 grid gap-4">
              {process.map((p, i) => (
                <div key={p.title} class="flex gap-4">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-sm font-black text-amber-800">
                    {i + 1}
                  </div>
                  <div>
                    <h4 class="text-sm font-black text-slate-900">{p.title}</h4>
                    <p class="mt-1 text-xs text-slate-600 leading-relaxed">{p.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ── SEO TEXT: PRIVATUMZUG LANDSHUT DETAIL ── */}
      <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
          <div class="prose prose-slate max-w-none">
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
              Privatumzug in Landshut – was Sie wissen sollten
            </h2>
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600">
              Ein <strong>Privatumzug in Landshut</strong> ist mehr als nur ein Transportauftrag. Je nach Lage der Wohnung – ob im Erdgeschoss in der Altstadt, im 4. Obergeschoss in Nikola oder in einem Einfamilienhaus in Ergolding – variieren Aufwand, Zeitbedarf und die benötigten Materialien erheblich. Umzüge LAF plant Ihren Wohnungsumzug deshalb immer individuell: Etagen, Aufzug, Parkverbote, Halteverbotsschilder, Treppenhausbreite und Möbelgröße werden im Vorfeld abgeklärt.
            </p>

            <h3 class="mt-8 text-xl font-black text-slate-900">
              Privatumzug in Landshut: Ablauf und Vorbereitung
            </h3>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600">
              Der Ablauf eines professionellen Privatumzugs in Landshut beginnt mit einer klaren Anfrage. Sie teilen uns Startadresse, Zieladresse, Wohnungsgröße und Terminwunsch mit. Wir klären dann die Details – wie viele Etagen, ob ein Aufzug vorhanden ist, ob Möbel demontiert werden müssen und ob Sie Einpackservice wünschen. Auf dieser Basis erstellt Umzüge LAF ein verbindliches <strong>Festpreis-Angebot für Ihren Privatumzug in Landshut</strong>, das vor Umzugsbeginn schriftlich bestätigt wird.
            </p>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600">
              Am Umzugstag erscheinen unsere Möbelpacker pünktlich, schützen Böden, Türrahmen und empfindliche Oberflächen mit Schutzdecken und Kartonagen, tragen alle Gegenstände ordentlich und beladen das Fahrzeug professionell. Am Zielort wird ausgeladen, aufgebaut und – auf Wunsch – sogar eingeräumt.
            </p>

            <h3 class="mt-8 text-xl font-black text-slate-900">
              Wohnungsumzug in Landshut: Stadtteile und Besonderheiten
            </h3>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600">
              Landshut besteht aus sehr unterschiedlichen Stadtteilen, die beim Umzug ganz verschiedene Herausforderungen stellen. In der <strong>Altstadt und Neustadt</strong> sind enge Gassen und begrenzte Haltezonen häufig ein Thema – hier sind Halteverbotszonenschilder oft notwendig, die wir für Sie beantragen können. Im Stadtteil <strong>Nikola und Wolfgang</strong> dominieren Mehrfamilienhäuser, in denen wir regelmäßig umziehen. In <strong>Achdorf, Münchnerau und Schönbrunn</strong> sind Einfamilienhäuser und Reihenhäuser mit großen Möbelstücken üblich. In den Umlandgemeinden wie <strong>Ergolding, Altdorf, Essenbach und Kumhausen</strong> sind die Zufahrten meist gut zugänglich.
            </p>

            <h3 class="mt-8 text-xl font-black text-slate-900">
              Was kostet ein Privatumzug in Landshut?
            </h3>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600">
              Die Kosten für einen <strong>Wohnungsumzug in Landshut</strong> hängen von mehreren Faktoren ab: Wohnungsgröße (Anzahl Zimmer und Möbelmenge), Etagen mit oder ohne Aufzug, Entfernung zwischen alter und neuer Adresse sowie gewünschte Zusatzleistungen wie Einpackservice oder Möbelmontage. Als grobe Orientierung gilt: Ein kleiner 1- bis 2-Zimmer-Umzug innerhalb von Landshut ist meist in einem halben bis einem Tag erledigt. Größere Haushalte ab 4 Zimmer benötigen mehr Planung, gegebenenfalls zwei Fahrzeuge und ein erfahrenes Mehrmänner-Team.
            </p>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600">
              Bei Umzüge LAF erhalten Sie immer ein transparentes <strong>Festpreis-Angebot ohne versteckte Extrakosten</strong>. Kein Stundenlohn-Abrechnungsmodell mit bösen Überraschungen am Ende des Tages – sondern ein klarer Preis, der vor Beginn der Arbeiten feststeht.
            </p>

            <h3 class="mt-8 text-xl font-black text-slate-900">
              Checkliste: Das sollten Sie vor Ihrem Privatumzug in Landshut erledigen
            </h3>
            <ul class="mt-3 grid gap-2 text-sm text-slate-600">
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Halteverbotszone rechtzeitig beim Ordnungsamt Landshut beantragen (mind. 3–5 Werktage vorher)</span></li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Nachbarn über den Umzugstag informieren (Treppenhaus, Aufzugbelegung)</span></li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Strom, Internet und Heizung am neuen Wohnort rechtzeitig ummelden</span></li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Adressänderung bei Behörden, Bank, Krankenversicherung, Arbeitgeber und Versicherungen melden</span></li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Kühlschrank 24 Stunden vorher abtauen und leer räumen</span></li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Wichtige Dokumente und Wertsachen separat transportieren</span></li>
              <li class="flex items-start gap-2"><span class="mt-0.5 text-amber-500 font-black shrink-0">✓</span><span>Kartons beschriften (Raum + Inhalt) für schnelles Einräumen am Zielort</span></li>
            </ul>
          </div>
        </div>
      </section>

      {/* ── ANFRAGE SEKTION ── */}
      <section id="anfrage-formular" class="py-16 sm:py-24 bg-slate-900 text-white scroll-mt-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-amber-400/10 px-3 py-1 text-xs font-bold text-amber-300">
                <span>📍</span>
                <span>Standort: Ergoldinger Str. 15, 84030 Landshut</span>
              </div>

              <h2 class="mt-4 text-3xl sm:text-4xl font-black text-white">
                Privatumzug kostenlos anfragen
              </h2>

              <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
                Rufen Sie uns direkt an oder füllen Sie das kurze Formular aus. Wir
                melden uns umgehend mit einem verbindlichen Festpreis-Angebot bei Ihnen.
              </p>

              <div class="mt-6 rounded-2xl border border-slate-700 bg-slate-800/80 p-5">
                <p class="text-xs font-bold text-amber-400 uppercase tracking-wider">
                  Telefonische Beratung
                </p>
                <a
                  href={phoneHref}
                  class="mt-1 inline-flex items-center gap-2 text-xl font-black text-white hover:text-amber-400 transition"
                >
                  <span>📞</span>
                  <span>{phone}</span>
                </a>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-700 bg-white p-6 sm:p-8 text-slate-900 shadow-2xl">
              <h3 class="text-xl font-black text-slate-900">
                Online-Anfrage für Privatumzug
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                In 2 Minuten ausgefüllt – 100% unverbindlich.
              </p>
              <div class="mt-5">
                <ContactForm client:visible />
              </div>
            </div>
          </div>
        </div>
      </section>

      <LocalSeoLinks />
      <Footer />
    </main>
</Layout>
