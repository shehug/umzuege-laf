---
import Layout from "@/layouts/Layout.astro";
import Image from "@/components/ui/Image";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs";
import LocalSeoLinks from "@/components/LocalSeoLinks";
import KleintransportForm from "@/components/KleintransportForm";
import BookingCalendar from "@/components/BookingCalendar";
import { seoPages } from "@/lib/seo";

const meta = seoPages.kleintransporte;

const transportServices = [
  {
    title: "Einzelstück-Transport",
    desc: "z.B. Sofa, Waschmaschine, Kühlschrank oder Schreibtisch innerhalb von Landshut. Inkl. Transporter & Fahrer.",
    idealFor: "Kleinanzeigen & Gerätekauf",
    highlight: "Inkl. Transporter & Fahrer",
  },
  {
    title: "IKEA & Möbelhaus-Abholung",
    desc: "Direkte Abholung bei IKEA Eching, IKEA Regensburg, POCO oder Höffner mit Lieferung bis in die Wohnung.",
    idealFor: "Neuanschaffungen & Bausätze",
    highlight: "Direkt bis in die Wohnung",
  },
  {
    title: "WG-Zimmer & Kleinumzug",
    desc: "Bett, Schrank, Tisch und ca. 10 bis 15 Kartons. Perfekt für Studenten, Singles und Pendler in Landshut.",
    idealFor: "1-Zimmer / WG-Zimmer",
    highlight: "Ideal für Studenten & Singles",
  },
  {
    title: "Kurzfristiger Transport",
    desc: "Wenn es eilig ist, fragen Sie telefonisch nach einem kurzfristigen Termin. Wir prüfen die verfügbaren Kapazitäten.",
    idealFor: "Notfälle & Spontankäufe",
    highlight: "Termin nach Verfügbarkeit",
  },
];

const useCases = [
  {
    title: "Kleinanzeigen & Gebrauchtmöbel",
    desc: "Sie haben auf eBay Kleinanzeigen ein Traumsofa oder einen Schrank in Landshut oder Umgebung gefunden? Wir holen es direkt beim Verkäufer ab.",
  },
  {
    title: "IKEA, Möbelhäuser & Baumärkte",
    desc: "Kein eigenes großes Auto? Wir fahren zu IKEA Eching, Möbel Höffner, POCO oder OBI, laden Ihre Ware ein und tragen sie direkt in Ihre Wohnung.",
  },
  {
    title: "Haushaltsgeräte (Weiße Ware)",
    desc: "Schwere Waschmaschinen, Kühlschränke oder Trockner transportieren wir fachgerecht stehend und sichern sie mit professionellen Gurten.",
  },
  {
    title: "Studenten & WG-Umzüge",
    desc: "Schnell, unkompliziert und budgetfreundlich: Transportieren Sie Ihr WG-Zimmer von oder nach Landshut ohne teuren Groß-LKW.",
  },
];

const faqs = [
  {
    q: "Sind kurzfristige Kleintransporte in Landshut möglich?",
    a: "Kurzfristige Termine sind abhängig von unseren verfügbaren Kapazitäten möglich. Rufen Sie uns unter 0162 900 75 65 an und nennen Sie Transportgut, Start- und Zieladresse sowie Ihren Terminwunsch. Wir prüfen, wann der Transport durchgeführt werden kann.",
  },
  {
    q: "Kann ich Transport und Tragehilfe gemeinsam anfragen?",
    a: "Ja. Teilen Sie uns mit, welche Gegenstände transportiert werden sollen und ob Unterstützung beim Tragen benötigt wird. Bitte nennen Sie auch Etagen, Aufzug und Zugangsbedingungen an beiden Adressen. Fahrzeug und Personal stimmen wir anhand des Auftrags ab.",
  },
  {
    q: "Was kostet eine Möbelhaus-Abholung nach Landshut?",
    a: "Die Kosten hängen von Abholort, Lieferadresse, Umfang der Möbel und Bedingungen vor Ort ab. Senden Sie uns diese Angaben für ein individuelles Angebot. Abholtermin, Warenfreigabe und erforderliche Unterlagen stimmen wir vor der Durchführung mit Ihnen ab.",
  },
  {
    q: "Sind die transportierten Möbel versichert?",
    a: "Umzüge LAF verfügt über Versicherungsschutz für Transportleistungen. Fragen zum Umfang, zu den Bedingungen und zu Ihren Transportgegenständen klären wir vor der Beauftragung.",
  },
  {
    q: "Wie wird der Preis für einen Kleintransport berechnet?",
    a: "Für die Kalkulation berücksichtigen wir Transportgut, Fahrstrecke, Etagen, Tragewege und vereinbarte Zusatzleistungen. Nach Prüfung Ihrer Angaben erhalten Sie ein Angebot, in dem Preis und Leistungsumfang festgehalten werden.",
  },
];

const structuredDataGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MovingCompany",
      "@id": "https://umzuegelandshut.de/#organization",
      name: "Umzüge LAF",
      url: "https://umzuegelandshut.de/",
      logo: "https://umzuegelandshut.de/images/logo/laf-logo.png",
      telephone: "+491629007565",
      priceRange: "€€",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Ergoldinger Str. 15",
        addressLocality: "Landshut",
        postalCode: "84030",
        addressRegion: "Bayern",
        addressCountry: "DE",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 48.5529,
        longitude: 12.1648,
      },
      areaServed: [
        "Landshut",
        "Ergolding",
        "Altdorf",
        "Essenbach",
        "Kumhausen",
        "Vilsbiburg",
        "Moosburg an der Isar",
        "Landkreis Landshut",
      ],
    },
    {
      "@type": "Service",
      "@id": "https://umzuegelandshut.de/kleintransporte-landshut/#service",
      name: "Kleintransporte Landshut",
      url: "https://umzuegelandshut.de/kleintransporte-landshut",
      serviceType: "Kleintransport & Möbeltransport",
      description:
        "Spontane Kleintransporte und Möbeltransporte in Landshut und Umgebung. Express-Lieferung, Möbelhaus-Abholung (IKEA) und Einzelstück-Transporte zum fairen Festpreis.",
      provider: {
        "@id": "https://umzuegelandshut.de/#organization",
      },
      areaServed: {
        "@type": "City",
        name: "Landshut",
      },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "EUR",
        priceRange: "€€",
        url: "https://umzuegelandshut.de/kleintransporte-landshut",
      },
    },
    {
      "@type": "FAQPage",
      "@id": "https://umzuegelandshut.de/kleintransporte-landshut/#faq",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: f.a,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://umzuegelandshut.de/kleintransporte-landshut/#breadcrumb",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Startseite",
          item: "https://umzuegelandshut.de/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Leistungen",
          item: "https://umzuegelandshut.de/leistungen",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Kleintransporte Landshut",
          item: "https://umzuegelandshut.de/kleintransporte-landshut",
        },
      ],
    },
  ],
};
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.path}
  image={meta.image}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredDataGraph)}
  />

  <main class="min-h-screen bg-white text-slate-900">
    <Header />

    <!-- ================= HERO SECTION ================= -->
    <section class="relative overflow-hidden bg-slate-950 pt-28 pb-16 text-white sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28">
      {/* Background Hero Image */}
      <div class="absolute inset-0 z-0 opacity-60">
        <Image
          src="/images/services/Express.jpg"
          alt="Umzüge LAF Kleintransporte und Möbeltransporte Landshut"
          fill
          priority
          class="object-cover object-center sm:object-right"
        />
      </div>
      <div class="absolute inset-0 z-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/30 sm:to-transparent"></div>
      <div class="absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-4">
          <Breadcrumbs
            items={[
              { label: "Leistungen", href: "/leistungen" },
              { label: "Kleintransporte Landshut" },
            ]}
          />
        </div>

        <div class="grid items-center gap-12 lg:grid-cols-12">
          {/* Left Column Text */}
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-4 py-1.5 text-xs sm:text-sm font-bold text-amber-300 backdrop-blur-md">
              <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
              Sofort verfügbar · Spontan & Flexibel in Landshut
            </div>

            <h1 class="mt-6 text-3xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
              Kleintransporte & <span class="text-amber-400">Möbeltransport</span> in Landshut
            </h1>

            <p class="mt-6 text-base sm:text-lg leading-relaxed text-slate-300">
              Sie möchten ein Sofa transportieren, eine Waschmaschine abholen oder Möbel aus einem Möbelhaus nach Hause bringen lassen? Umzüge LAF übernimmt Kleintransporte in Landshut und Umgebung. Teilen Sie uns Transportgut, Start- und Zieladresse sowie Ihren Wunschtermin mit.
            </p>

            {/* USPs */}
            <div class="mt-8 grid gap-3 sm:grid-cols-2 text-xs sm:text-sm font-bold text-slate-200">
              <div class="flex items-center gap-2">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                <span>Faire Festpreise auf Anfrage</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                <span>Spontane Termine auch am Wochenende</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                <span>Inkl. Transporter, Sprit & Tragehilfe</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                <span>IKEA Eching & Regensburg Abholservice</span>
              </div>
            </div>

            <div class="mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
              <a
                href="#anfrage"
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-amber-500 px-7 py-3.5 text-sm sm:text-base font-black text-slate-950 shadow-xl shadow-amber-500/25 transition hover:bg-amber-400 hover:scale-105"
              >
                <span>Express-Anfrage ↓</span>
              </a>
              <a
                href="#termin-reservierung"
                class="inline-flex items-center justify-center gap-2 rounded-2xl border-2 border-amber-400/80 bg-slate-900/90 px-6 py-3.5 text-sm sm:text-base font-black text-amber-300 transition hover:bg-slate-800"
              >
                <span>📅 Online Termin buchen</span>
              </a>
              <a
                href="tel:+491629007565"
                class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-700 bg-slate-800/80 px-6 py-3.5 text-sm sm:text-base font-bold text-white transition hover:bg-slate-700"
              >
                <svg class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>0162 900 75 65 Blitzanruf</span>
              </a>
            </div>
          </div>

          {/* Right Column: Trust & Highlights Card */}
          <div class="lg:col-span-5">
            <div class="rounded-3xl border border-slate-800 bg-slate-900/90 p-6 sm:p-8 backdrop-blur-md shadow-2xl">
              <div class="inline-flex items-center gap-2 rounded-full bg-amber-400/10 border border-amber-400/30 px-3 py-1 text-xs font-bold text-amber-300">
                <span>⚡</span>
                <span>Express-Service Landshut</span>
              </div>
              <h2 class="mt-4 text-xl sm:text-2xl font-black text-white">
                Möbeltransport für Einzelstücke und kleine Umzüge
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">
                Ob Einzelmöbel, Kleinanzeigen-Kauf oder WG-Zimmer: Wir stimmen Transportumfang, Zugangsbedingungen und Termin mit Ihnen ab.
              </p>

              <div class="mt-6 space-y-3 border-t border-slate-800 pt-5 text-xs sm:text-sm text-slate-200">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                  <span>Transporter inklusive Fahrer &amp; Kraftstoff</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                  <span>Auf Wunsch mit 1 oder 2 Tragehelfern</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                  <span>Spontane Termine oft noch am selben Tag</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-400 text-slate-950 font-black text-xs">✓</span>
                  <span>Vollständig transport- und haftpflichtversichert</span>
                </div>
              </div>

              <div class="mt-8 grid gap-3">
                <a
                  href="#anfrage"
                  class="flex items-center justify-center gap-2 rounded-xl bg-amber-400 py-3.5 text-center text-sm font-black text-slate-950 shadow-lg hover:bg-amber-300 transition"
                >
                  <span>Direkt online anfragen ↓</span>
                </a>
                <a
                  href="tel:+491629007565"
                  class="flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-800/80 py-3 text-center text-xs font-bold text-white hover:bg-slate-800 transition"
                >
                  <span>📞 0162 900 75 65 Blitzanruf</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= TRANSPORT CATEGORIES (OHNE PREISE) ================= -->
    <section class="py-16 sm:py-24 bg-slate-50 border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600">
            Transport-Leistungen
          </span>
          <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-4xl">
            Beliebte Kleintransport-Optionen in Landshut
          </h2>
          <p class="mt-3 text-sm sm:text-base text-slate-600">
            Der Preis hängt von Transportgut, Fahrstrecke, Etagen und vereinbarten Zusatzleistungen ab. Nach Prüfung Ihrer Angaben erhalten Sie Ihr individuelles Angebot.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {transportServices.map((item) => (
            <div class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md hover:border-amber-300">
              <div>
                <span class="inline-block rounded-full bg-amber-400/20 px-2.5 py-1 text-[11px] font-bold text-amber-900 mb-3">
                  {item.idealFor}
                </span>
                <h3 class="text-lg font-bold text-slate-900">{item.title}</h3>
                <div class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-extrabold text-amber-800 border border-amber-200">
                  <span>✓</span>
                  <span>{item.highlight}</span>
                </div>
                <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {item.desc}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100">
                <a
                  href="#anfrage"
                  class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1 group"
                >
                  <span>Jetzt reservieren</span>
                  <span class="transition group-hover:translate-x-0.5">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= ANFRAGE-FORMULAR (UNTEN ANSTATT PREISE) ================= -->
    <section id="anfrage" class="py-16 sm:py-24 bg-slate-900 text-white scroll-mt-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-400/10 px-3.5 py-1.5 text-xs font-extrabold text-amber-300">
            <span>⚡</span>
            <span>Express-Anfrage · Verbindliches Festpreis-Angebot</span>
          </span>
          <h2 class="mt-3 text-2xl sm:text-4xl font-black text-white">
            Kleintransport oder Möbeltransport unverbindlich anfragen
          </h2>
          <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
            Wählen Sie Ihre Transportgüter aus und teilen Sie uns Start- und Zieladresse, Etagen sowie Ihren Wunschtermin mit. Wir prüfen Ihre Angaben und erstellen ein Angebot für den abgestimmten Leistungsumfang.
          </p>
        </div>

        <KleintransportForm client:load />
      </div>
    </section>

    <!-- ================= USE CASES ================= -->
    <section class="py-16 sm:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600">
            Vielseitig & Spontan
          </span>
          <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-4xl">
            Wofür werden unsere Kleintransporte gebucht?
          </h2>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {useCases.map((u) => (
            <div class="rounded-3xl border border-slate-200 bg-slate-50/60 p-6 sm:p-8">
              <h3 class="text-lg font-bold text-slate-900">{u.title}</h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">{u.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= FAQ SECTION ================= -->
    <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600">
            Häufige Fragen
          </span>
          <h2 class="mt-2 text-2xl font-black text-slate-900 sm:text-4xl">
            FAQ: Kleintransporte Landshut
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details
              class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition open:shadow-md"
              open={index === 0}
            >
              <summary class="flex cursor-pointer items-center justify-between text-base font-bold text-slate-900 select-none">
                <span>{faq.q}</span>
                <span class="ml-4 flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition group-open:rotate-180 group-open:bg-amber-400 group-open:text-slate-950">
                  ↓
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-600 border-t border-slate-100 pt-3">
                {faq.a}
              </p>
            </details>
          ))}
        </div>

        <div class="mt-12 text-center rounded-3xl bg-slate-900 text-white p-8 sm:p-10 shadow-xl">
          <h3 class="text-xl font-bold sm:text-2xl text-white">
            Benötigen Sie kurzfristig einen Möbeltransport?
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-300 max-w-xl mx-auto">
            Rufen Sie uns an und schildern Sie Ihren Transportwunsch. Wir prüfen unsere Kapazitäten und besprechen einen möglichen Termin mit Ihnen.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a
              href="tel:+491629007565"
              class="inline-flex items-center gap-2 rounded-xl bg-amber-500 px-6 py-3.5 text-sm font-black text-slate-950 hover:bg-amber-400 transition"
            >
              0162 900 75 65 Express anrufen
            </a>
            <a
              href="https://wa.me/491629007565"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800 px-6 py-3.5 text-sm font-bold text-white hover:bg-slate-700 transition"
            >
              WhatsApp Sofort-Chat
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= ONLINE TERMIN RESERVIERUNG ================= -->
    <section id="termin-reservierung" class="py-16 sm:py-24 bg-slate-900 text-white scroll-mt-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center mb-10">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-400/20 px-3.5 py-1.5 text-xs font-black text-amber-300">
            <span>📅</span>
            <span>Online-Terminbuchung · Sofortige Bestätigung</span>
          </span>
          <h2 class="mt-3 text-2xl sm:text-4xl font-black text-white">
            Wunschtermin für Möbeltransport oder Besichtigung reservieren
          </h2>
          <p class="mt-3 text-sm sm:text-base text-slate-300">
            Wählen Sie direkt im Live-Kalender einen freien Tag und eine Uhrzeit für Ihren Kleintransport oder für ein Vorab-Gespräch in Landshut aus.
          </p>
        </div>

        <BookingCalendar client:visible />
      </div>
    </section>

    <!-- Local Area Links -->
    <LocalSeoLinks />
  </main>

  <Footer />
</Layout>
