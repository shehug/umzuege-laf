---
import Layout from "@/layouts/Layout.astro";
import LocalSeoLanding from "@/components/LocalSeoLanding.astro";
import { createSeoMetadata, seoPages } from "@/lib/seo";

const meta = createSeoMetadata(seoPages.dachbodenentruempelung);
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <LocalSeoLanding
      breadcrumbName="Dachbodenentrümpelung Landshut"
      path="/entruempelung/dachbodenentruempelung"
      serviceName="Dachbodenentrümpelung Landshut"
      serviceType="Dachbodenentrümpelung"
      serviceDescription="Dachbodenentrümpelung in Landshut mit Umzüge LAF. Zuverlässige und saubere Räumung von Dachböden und Speichern."
      badge="Saubere Speicherräumung"
      h1Top="Dachbodenentrümpelung Landshut."
      h1Highlight="Gründlich geräumt & sauber übergeben."
      h1Bottom="Auch bei steilen Treppen."
      intro="Dachboden voller alter Kisten, Möbel und Staub? Umzüge LAF räumt Ihren Speicher in Landshut zügig und sicher frei – inklusive fachgerechtem Abtransport."
      image="/images/services/ent3.jpg"
      imageAlt="Dachbodenentrümpelung von Umzüge LAF in Landshut"
      sectionKicker="Speicherräumung"
      sectionTitle="Sicheres Tragen auch über enge Dachbodentreppen."
      sectionText="Das Ausräumen eines Speichers ist oft mühsam, staubig und anstrengend. Unser erfahrenes Team trägt alle Kisten, Möbelteile und Gegenstände vorsichtig durchs Haus nach draußen und übergibt den Dachboden besenrein."
      benefits={[
        "Sicheres Tragen über steile oder enge Treppen",
        "Komplette Sortierung & fachgerechte Entsorgung",
        "Besenreine Übergabe des Speichers",
        "Verbindliche Festpreise ohne Zusatzkosten",
        "Zügige Terminabwicklung in Landshut",
        "Kombinierbar mit Umzügen",
      ]}
      steps={[
        { title: "Speicher beschreiben", text: "Sie nennen uns Größe, Zugangssituation und die ungefähre Füllmenge." },
        { title: "Festpreisangebot erhalten", text: "Wir berechnen einen fairen Komplettpreis inklusive aller Entsorgungskosten." },
        { title: "Räumung durchführen", text: "Unser Team räumt den Speicher vollständig aus und verlädt das Material." },
        { title: "Besenrein übergeben", text: "Der Dachboden wird sauber ausgefegt und leer an Sie übergeben." },
      ]}
      relatedServices={[
        { title: "Entrümpelung Landshut", text: "Hauptseite für alle Entrümpelungsdienste.", href: "/entruempelung-landshut" },
        { title: "Kellerentrümpelung", text: "Kellerräume und Abteile sauber räumen lassen.", href: "/entruempelung/kellerentruempelung" },
        { title: "Sperrmüllentsorgung", text: "Abholung von Einzelmöbeln & Großteilen.", href: "/entruempelung/sperrmuellentsorgung" },
      ]}
      faqs={[
        { q: "Muss der Dachboden beleuchtet sein?", a: "Nein, unser Team bringt bei Bedarf mobile Arbeitsleuchten mit." },
        { q: "Was passiert mit brauchbaren Gegenständen?", a: "Alles, was Sie behalten möchten, stellen wir zur Seite. Nur der Rest wird entsorgt." },
        { q: "Wie lange dauert eine Dachbodenentrümpelung?", a: "In den meisten Fällen ist die Räumung innerhalb weniger Stunden am selben Tag erledigt." },
      ]}
    />
</Layout>
