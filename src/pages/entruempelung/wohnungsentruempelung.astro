---
import Layout from "@/layouts/Layout.astro";
import LocalSeoLanding from "@/components/LocalSeoLanding.astro";
import { createSeoMetadata, seoPages } from "@/lib/seo";

const meta = createSeoMetadata(seoPages.wohnungsentruempelung);
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <LocalSeoLanding
      breadcrumbName="Wohnungsentrümpelung Landshut"
      path="/entruempelung/wohnungsentruempelung"
      serviceName="Wohnungsentrümpelung Landshut"
      serviceType="Wohnungsentrümpelung"
      serviceDescription="Wohnungsentrümpelung in Landshut mit Umzüge LAF. Zuverlässige und besenreine Räumung von Wohnungen und Häusern zum Festpreis."
      badge="Diskret & Besenrein"
      h1Top="Wohnungsentrümpelung Landshut."
      h1Highlight="Schnell, diskret & besenrein."
      h1Bottom="Komplett stressfrei."
      intro="Wohnungsauflösung oder Umzug? Umzüge LAF räumt Wohnungen und Häuser in Landshut komplett leer, entsorgt Altmöbel fachgerecht und übergibt die Räume besenrein an Vermieter oder Eigentümer."
      image="/images/services/ent3.jpg"
      imageAlt="Wohnungsentrümpelung von Umzüge LAF in Landshut"
      sectionKicker="Wohnungsräumung"
      sectionTitle="Sauber geräumt, termingerecht übergeben."
      sectionText="Ob bei Auszug, Nachlass oder Modernisierung: Eine vollständige Wohnungsräumung erfordert System, Menpower und eine ordnungsgemäße Mülltrennung. Wir übernehmen die gesamte Arbeit für Sie."
      benefits={[
        "Besenreine Übergabe für Vermieter & Eigentümer",
        "Demontage von Schränken, Küchen & Lampen",
        "Fachgerechte Trennung & Entsorgung aller Materialien",
        "Diskrete & pietätvolle Durchführung bei Nachlässen",
        "Verbindlicher Festpreis ohne Zusatzkosten",
        "Kostenlose Vor-Ort-Besichtigung möglich",
      ]}
      steps={[
        { title: "Besichtigung / Absprache", text: "Wir erfassen Zimmeranzahl, Etage, Möbel und Entsorgungsbedarf." },
        { title: "Festpreisangebot erhalten", text: "Sie erhalten ein transparentes Festpreis-Angebot ohne versteckte Kosten." },
        { title: "Komplette Räumung", text: "Unser Team räumt Möbel, Teppiche, Hausrat und Sperrmüll zügig aus der Wohnung." },
        { title: "Besenreine Übergabe", text: "Alle Räume werden gründlich ausgefegt und übergabefertig hinterlassen." },
      ]}
      relatedServices={[
        { title: "Entrümpelung Landshut", text: "Hauptseite für alle Entrümpelungsdienste in Landshut.", href: "/entruempelung-landshut" },
        { title: "Kellerentrümpelung", text: "Kellerräume und Abteile sauber freiräumen lassen.", href: "/entruempelung/kellerentruempelung" },
        { title: "Privatumzug Landshut", text: "Wohnungsumzug mit Transport und Möbelmontage.", href: "/privatumzug-landshut" },
      ]}
      faqs={[
        { q: "Muss die Wohnung vorher vorbereitet werden?", a: "Nein, Sie können persönliche Gegenstände und Wertgegenstände vorab mitnehmen – um alles andere kümmert sich unser Team." },
        { q: "Werden auch Küchen und Einbauten demontiert?", a: "Ja, wir demontieren Einbauküchen, Wandschränke, Vorhangstangen und Lampen nach Absprache fachgerecht." },
        { q: "Erhalten wir einen Entsorgungsnachweis?", a: "Ja, alle Gegenstände und Materialien werden ordnungsgemäß über zertifizierte Entsorgungsfachbetriebe in Landshut entsorgt." },
      ]}
    />
</Layout>
