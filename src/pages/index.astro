---
import Layout from "@/layouts/Layout.astro";
import Image from "@/components/ui/Image";
import { createSeoMetadata, seoPages } from "@/lib/seo";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LocalSeoLinks from "@/components/LocalSeoLinks";
import ContactForm from "@/components/ContactForm";
import GoogleReviews from "@/components/GoogleReviews";
import NikeCheck from "@/components/NikeCheck.astro";

const phone = "0162 900 75 65";
const phoneHref = "tel:+491629007565";

const trustPillars = [
  {
    id: "festpreis",
    title: "Garantierter Festpreis",
    desc: "Verbindliche Angebote ohne versteckte Gebühren oder Nachforderungen am Umzugstag.",
  },
  {
    id: "versicherung",
    title: "Versicherter Umzug",
    desc: "Voller Versicherungsschutz für Transport und Möbelmontage bei jedem Auftrag inklusive.",
  },
  {
    id: "regional",
    title: "Regional aus Landshut",
    desc: "Ortskundiges Umzugsteam direkt aus Landshut mit kostenloser Vor-Ort-Besichtigung.",
  },
  {
    id: "schnelligkeit",
    title: "Angebot in 4 Stunden",
    desc: "Schnelle Rückmeldung mit Festpreis-Angebot innerhalb von 4 Stunden (Mo–Sa 08:00–18:00 Uhr).",
  },
];

const mainServices = [
  {
    title: "Privatumzug Landshut",
    badge: "Beliebt",
    text: "Stressfreier Wohnungsumzug oder Hausumzug mit Einpackservice, Möbeltransport und Montage.",
    href: "/privatumzug-landshut",
    image: "/images/services/privatumzug.jpg",
  },
  {
    title: "Firmenumzug Landshut",
    badge: "Gewerbe",
    text: "Strukturierte Büroumzüge, Praxisumzüge und Gewerbeumzüge mit minimaler Ausfallzeit.",
    href: "/firmenumzug-landshut",
    image: "/images/services/firmenumzug.jpg",
  },
  {
    title: "Möbelmontage",
    badge: "Handwerk",
    text: "Fachgerechter Abbau, sicherer Transport und stabiler Wiederaufbau aller Möbel.",
    href: "/umzuege/moebelmontage",
    image: "/images/services/Montage.jpg",
  },
  {
    title: "Entrümpelung & Räumung",
    badge: "Besenrein",
    text: "Wohnungsauflösungen, Keller, Dachböden und Sperrmüllentsorgung schnell und sauber.",
    href: "/entruempelung-landshut",
    image: "/images/services/entruempelung.jpg",
  },
];

const steps = [
  {
    num: "1",
    title: "Kurze Anfrage oder Anruf",
    text: "Nennen Sie uns Startadresse, Zieladresse und den ungefähren Umfang in nur 2 Minuten.",
  },
  {
    num: "2",
    title: "Verbindliches Festpreis-Angebot",
    text: "Bei vollständigen Angaben zu Ihrem Umzug erhalten Sie während unserer Geschäftszeiten innerhalb von vier Stunden ein Angebot. Geschäftszeiten: Mo–Sa, 08:00–18:00 Uhr. Außerhalb dieser Zeiten beginnt die Vier-Stunden-Frist mit dem nächsten Geschäftszeitbeginn. Gezählt werden ausschließlich Stunden innerhalb der Geschäftszeiten.",
  },
  {
    num: "3",
    title: "Pünktlich & entspannt umziehen",
    text: "Unser geschultes Team erledigt Tragen, Transport und Montage zuverlässig für Sie.",
  },
];

const homeFaqs = [
  {
    q: "Was kostet ein Umzug in Landshut mit Umzüge LAF?",
    a: "Die Kosten richten sich nach Wohnungsgröße, Etage, Entfernung und gewünschten Zusatzleistungen (z. B. Montage oder Einpackservice). Nach Erhalt Ihrer Eckdaten erstellen wir einen verbindlichen Festpreis ohne Nachforderungen.",
  },
  {
    q: "Wie schnell erhalte ich mein Umzugsangebot?",
    a: "Bei vollständigen Angaben zu Ihrem Umzug erhalten Sie innerhalb von vier Stunden während unserer Geschäftszeiten ein Angebot. Wir sind Montag bis Samstag von 08:00 bis 18:00 Uhr erreichbar. Für Anfragen außerhalb dieser Zeiten beginnt die Vier-Stunden-Frist mit dem nächsten Geschäftszeitbeginn. Gezählt werden ausschließlich Stunden innerhalb unserer Geschäftszeiten.",
  },
  {
    q: "Sind meine Möbel beim Transport versichert?",
    a: "Umzüge LAF verfügt über Versicherungsschutz für Umzugsleistungen. Welche Leistungen und Gegenstände im konkreten Auftrag versichert sind und welche Bedingungen gelten, klären wir vor der Beauftragung.",
  },
  {
    q: "Sind auch kurzfristige Umzugstermine möglich?",
    a: "Ja! Durch unsere flexible Teamplanung in Landshut können wir oft auch kurzfristige oder dringende Express-Umzüge innerhalb von 24–48 Stunden realisieren.",
  },
  {
    q: "Übernehmen Sie auch Möbelmontage und Küchenabbau?",
    a: "Ja, unser Team baut Ihre Schränke, Betten, Regale und Möbel fachgerecht ab und baut sie am Zielort wieder stabil auf.",
  },
  {
    q: "Kombinieren Sie Umzug auch mit Entrümpelung oder Sperrmüll?",
    a: "Ja, wir können nicht mehr benötigte Altmöbel, Kellerabteile oder Sperrmüll direkt im Rahmen Ihres Umzugs fachgerecht entsorgen.",
  },
];

const meta = createSeoMetadata(seoPages.home);


---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <main class="min-h-screen bg-white text-slate-900">
      <Header />

      {/* ── HERO SECTION ── */}
      <section class="relative overflow-hidden bg-slate-950 pt-28 pb-16 text-white sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28">
        <div class="absolute inset-0 z-0 opacity-60">
          <Image
            src="/images/hero/Hero.jpg"
            alt="Umzüge LAF Transporter und Team Landshut"
            fill
            priority
            fetchPriority="high"
            quality={70}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 75vw, 1200px"
            class="object-cover object-center sm:object-right"
          />
        </div>
        {/* Soft directional gradient: dark on left for text, clear fade on right for photo */}
        <div class="absolute inset-0 z-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/30 sm:to-transparent" />
        <div class="absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40" />

        <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
            <div>
              {/* Trust Tag */}
              <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-400/10 px-3.5 py-1.5 text-xs font-extrabold text-amber-300">
                <span class="flex text-amber-400">★★★★★</span>
                <span>5.0 / 5.0 Google Bewertung · Umzüge Landshut</span>
              </div>

              <h1 class="text-3xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
                Umzugsunternehmen &amp; Umzugsfirma Landshut.<br />
                <span class="text-amber-400">Stressfreie Umzüge zum Festpreis.</span>
              </h1>

              <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">
                Ihr erfahrenes <strong>Umzugsunternehmen</strong> und Ihre zuverlässige <strong>Umzugsfirma</strong> für <strong>Umzüge in Landshut</strong> und Region. Als eingespieltes Team vor Ort übernehmen wir Privatumzüge, Firmenumzüge, Möbelmontage, Einpackservice und Entrümpelungen — zuverlässig, pünktlich und zum verbindlichen Festpreis.
              </p>

              {/* CTAs */}
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
                <a
                  href={phoneHref}
                  data-track="phone"
                  data-track-loc="Hero_Phone"
                  class="flex items-center justify-center gap-2.5 rounded-full bg-[#f59e0b] px-7 py-4 text-center text-base font-black text-slate-950 shadow-lg transition hover:bg-amber-400 active:scale-98"
                >
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
                    <path strokeLinecap="round" strokeLinejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Direkt anrufen: {phone}</span>
                </a>

                <a
                  href="#direktanfrage"
                  class="flex items-center justify-center rounded-full border-2 border-slate-600 bg-slate-800/80 px-7 py-4 text-center text-base font-bold text-white transition hover:border-slate-400 hover:bg-slate-700 active:scale-98"
                >
                  Kostenlos anfragen →
                </a>
              </div>

              {/* Mini Trust Checklist */}
              <div class="mt-8 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs sm:text-sm font-semibold text-slate-300">
                <div class="flex items-center gap-2 group cursor-default">
                  <NikeCheck delay="0s" />
                  <span class="transition-colors group-hover:text-white">Kostenlose Besichtigung</span>
                </div>
                <div class="flex items-center gap-2 group cursor-default">
                  <NikeCheck delay="0.5s" />
                  <span class="transition-colors group-hover:text-white">Transparenter Festpreis</span>
                </div>
                <div class="flex items-center gap-2 group cursor-default">
                  <NikeCheck delay="1s" />
                  <span class="transition-colors group-hover:text-white">Angebot in 4 Std. (Mo–Sa)</span>
                </div>
              </div>
            </div>

            {/* Quick Hero Card */}
            <div class="hidden lg:block rounded-2xl border border-slate-800 bg-slate-900/90 p-8 shadow-2xl backdrop-blur-md">
              <div class="flex items-center justify-between border-b border-slate-800 pb-5">
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-amber-400">
                    Kunden-Zufriedenheit
                  </p>
                  <p class="mt-1 text-2xl font-black text-white">5.0 von 5.0 Sternen</p>
                </div>
                <div class="flex text-amber-400 text-lg">★★★★★</div>
              </div>

              <div class="mt-6 space-y-4 text-sm text-slate-300">
                <div class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400">
                    ✓
                  </span>
                  <p><strong class="text-white">Pünktlich & Zuverlässig:</strong> Feste Termine ohne Verzögerungen.</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400">
                    ✓
                  </span>
                  <p><strong class="text-white">Sorgfältiges Tragen:</strong> Schutzdecken & Spanngurte für jedes Möbelstück.</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400">
                    ✓
                  </span>
                  <p><strong class="text-white">Alles aus einer Hand:</strong> Transport, Montage & Entsorgung.</p>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-slate-800 space-y-2.5">
                <a
                  href="/umzugskosten-landshut#umzugskosten-rechner"
                  data-track="calculator"
                  data-track-loc="QuickHeroCard_Rechner"
                  class="group flex items-center justify-center gap-2 w-full rounded-xl bg-amber-400 py-3.5 text-center text-sm font-black text-slate-950 transition hover:bg-amber-300 shadow-md"
                >
                  <span>🧮</span>
                  <span>Umzugskosten online berechnen</span>
                  <span class="transition-transform group-hover:translate-x-1">→</span>
                </a>
                <a
                  href="#direktanfrage"
                  class="block w-full rounded-xl border border-slate-700 bg-slate-800/80 py-2.5 text-center text-xs font-bold text-slate-300 transition hover:bg-slate-700 hover:text-white"
                >
                  Oder Schnell-Anfrageformular ausfüllen
                </a>
              </div>
            </div>
          </div>

          {/* ── 4 TRUST PILLARS ── */}
          <div class="mt-12 sm:mt-16 pt-8 sm:pt-10 border-t border-slate-800/80">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {trustPillars.map((p) => (
                <div
                  key={p.title}
                  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-800/90 bg-gradient-to-b from-slate-900/95 via-slate-900 to-slate-950 p-6 sm:p-7 shadow-xl shadow-slate-950/40 backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-400 hover:shadow-2xl hover:shadow-amber-500/15"
                >
                  {/* Top ambient highlight gradient */}
                  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-amber-500/0 via-amber-400 to-amber-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                  {/* Corner soft glow */}
                  <div class="pointer-events-none absolute -top-12 -right-12 h-32 w-32 rounded-full bg-amber-400/10 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                  <div class="flex flex-col h-full justify-between">
                    <div>
                      {/* Top Row: Icon Badge + Pill */}
                      <div class="flex items-center justify-between gap-3">
                        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-400/10 border border-amber-400/25 text-amber-400 shadow-sm transition-all duration-300 group-hover:scale-110 group-hover:bg-amber-400 group-hover:text-slate-950 group-hover:shadow-md group-hover:shadow-amber-400/30">
                          {p.id === "festpreis" && (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="12" r="9" />
                              <path d="M14.5 9a3.5 3.5 0 0 0-5 0v6a3.5 3.5 0 0 0 5 0M6 10.5h6M6 13.5h6" />
                            </svg>
                          )}
                          {p.id === "versicherung" && (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                              <path d="m9 12 2 2 4-4" />
                            </svg>
                          )}
                          {p.id === "regional" && (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                              <circle cx="12" cy="10" r="3" />
                            </svg>
                          )}
                          {p.id === "schnelligkeit" && (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="13" r="8" />
                              <path d="M12 9v4l2.5 2.5" />
                              <path d="M10 2h4" />
                              <path d="M12 2v3" />
                              <path d="M18.5 6.5l1.5-1.5" />
                            </svg>
                          )}
                        </div>

                        {p.id === "festpreis" && (
                          <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-2.5 py-0.5 text-[11px] font-bold text-amber-300">
                            Transparent
                          </span>
                        )}
                        {p.id === "versicherung" && (
                          <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 text-[11px] font-bold text-emerald-300">
                            Geschützt
                          </span>
                        )}
                        {p.id === "regional" && (
                          <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-2.5 py-0.5 text-[11px] font-bold text-amber-300">
                            Vor Ort
                          </span>
                        )}
                        {p.id === "schnelligkeit" && (
                          <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-2.5 py-0.5 text-[11px] font-bold text-amber-300">
                            Express
                          </span>
                        )}
                      </div>

                      <h3 class="mt-4 text-base sm:text-lg font-black text-white tracking-tight group-hover:text-amber-300 transition-colors duration-200">
                        {p.title}
                      </h3>
                      <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">
                        {p.desc}
                      </p>
                    </div>

                    {/* Bottom feature point for perfect height balance across cards */}
                    <div class="mt-5 pt-3.5 border-t border-slate-800/80 flex items-center gap-2 text-xs font-semibold text-slate-300">
                      <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-amber-400/20 text-[10px] font-black text-amber-400">
                        ✓
                      </span>
                      <span>
                        {p.id === "festpreis" && "Verbindliche Kosten ohne Überraschungen"}
                        {p.id === "versicherung" && "Zuverlässiger Schutz bei jedem Transport"}
                        {p.id === "regional" && "Kurze Wege & persönliche Beratung"}
                        {p.id === "schnelligkeit" && "Feste Antwortzeit während Bürozeiten"}
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ── 3-STEP PROCESS ── */}
      <section class="py-16 sm:py-24 bg-slate-50 border-b border-slate-200 mt-10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-2xl mx-auto">
            <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
              Einfacher Ablauf
            </p>
            <h2 class="mt-2 text-2xl sm:text-4xl font-black tracking-tight text-slate-900">
              Unser Ablauf: Von der kostenlosen Vor-Ort-Besichtigung bis zur Übergabe
            </h2>
            <p class="mt-3 text-sm sm:text-base text-slate-600">
              Klar, transparent und ohne komplizierten Papierkram.
            </p>
          </div>

          <div class="mt-12 grid gap-6 sm:grid-cols-3">
            {steps.map((s) => (
              <div
                key={s.num}
                class="relative flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm"
              >
                <div>
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-base font-black text-amber-800">
                    {s.num}
                  </div>
                  <p class="mt-5 text-lg font-black text-slate-900">{s.title}</p>
                  <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">{s.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── LEISTUNGEN GRID ── */}
      <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
              Unsere Leistungen
            </p>
            <h2 class="mt-2 text-2xl sm:text-4xl font-black tracking-tight text-slate-900">
              Professionelle Umzugsservices in Landshut
            </h2>
            <p class="mt-3 text-sm sm:text-base text-slate-600">
              Wählen Sie den passenden Service für Ihr Vorhaben:
            </p>
          </div>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {mainServices.map((srv) => (
              <div
                key={srv.title}
                class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-amber-400 hover:shadow-lg"
              >
                <div class="relative h-44 w-full overflow-hidden bg-slate-100">
                  <Image
                    src={srv.image}
                    alt={srv.title}
                    fill
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                    class="object-cover transition duration-300 group-hover:scale-105"
                  />
                  <div class="absolute top-3 left-3 rounded-md bg-slate-900/80 px-2.5 py-1 text-[11px] font-bold text-amber-300 backdrop-blur-sm">
                    {srv.badge}
                  </div>
                </div>

                <div class="flex flex-1 flex-col p-5">
                  <h3 class="text-base font-black text-slate-900 group-hover:text-[#b45309] transition">
                    <a href={srv.href} class="focus:outline-none">
                      <span class="absolute inset-0" aria-hidden="true"></span>
                      {srv.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed flex-1">
                    {srv.text}
                  </p>
                  <div class="mt-4 flex items-center gap-1 text-xs font-extrabold text-[#b45309]">
                    <span>Details ansehen</span>
                    <span>→</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── ECHTE KUNDENBEWERTUNGEN VOM GOOGLE PROFIL ── */}
      <GoogleReviews />

      {/* ── DIREKTANFRAGE FORMULAR SEKTION ── */}
      <section id="direktanfrage" class="py-16 sm:py-24 bg-slate-900 text-white scroll-mt-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-amber-400/10 px-3 py-1 text-xs font-bold text-amber-300">
                <span>📍</span>
                <span>Standort: Ergoldinger Str. 15, 84030 Landshut</span>
              </div>

              <h2 class="mt-4 text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
                Jetzt kostenloses Angebot anfordern.
              </h2>

              <p class="mt-4 text-base text-slate-300 leading-relaxed">
                Teilen Sie uns Startadresse, Zieladresse, Terminwunsch und den Umfang Ihres Umzugs mit. Bei vollständigen Angaben erhalten Sie während unserer Geschäftszeiten innerhalb von vier Stunden ein Angebot.
              </p>
              <p class="mt-2 text-xs sm:text-sm text-slate-400 leading-relaxed">
                Geschäftszeiten: Mo–Sa, 08:00–18:00 Uhr. Außerhalb dieser Zeiten beginnt die Vier-Stunden-Frist mit dem nächsten Geschäftszeitbeginn. Gezählt werden ausschließlich Stunden innerhalb der Geschäftszeiten.
              </p>

