---
import Layout from "@/layouts/Layout.astro";
import Image from "@/components/ui/Image";
import { createSeoMetadata, seoPages } from "@/lib/seo";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LocalSeoLinks from "@/components/LocalSeoLinks";
import ServiceJsonLd from "@/components/ServiceJsonLd";
import BreadcrumbJsonLd from "@/components/BreadcrumbJsonLd";
import Breadcrumbs from "@/components/Breadcrumbs";
import ContactForm from "@/components/ContactForm";

const phone = "0162 900 75 65";
const phoneHref = "tel:+491629007565";

const clearingServices = [
  {
    title: "Wohnungsentrümpelung",
    text: "Komplette Wohnungen sauber räumen lassen — zuverlässig, diskret und besenrein.",
    href: "/entruempelung/wohnungsentruempelung",
  },
  {
    title: "Haushaltsauflösung",
    text: "Strukturierte Haushaltsauflösungen mit Planung, Räumung und fachgerechter Entsorgung.",
    href: "/entruempelung/haushaltsaufloesung",
  },
  {
    title: "Kellerentrümpelung",
    text: "Kellerflächen schnell und sauber freiräumen — auch bei schwer zugänglichen Bereichen.",
    href: "/entruempelung/kellerentruempelung",
  },
  {
    title: "Dachbodenentrümpelung",
    text: "Dachböden professionell räumen lassen, inklusive Sortierung und Abtransport.",
    href: "/entruempelung/dachbodenentruempelung",
  },
  {
    title: "Garagenentrümpelung",
    text: "Garagen, Schuppen und Abstellflächen wieder nutzbar machen — sauber und effizient.",
    href: "/entruempelung/garagenentruempelung",
  },
  {
    title: "Sperrmüllentsorgung",
    text: "Sperrmüll, Altmöbel und Großteile fachgerecht abholen und entsorgen lassen.",
    href: "/entruempelung/sperrmuellentsorgung",
  },
];

const process = [
  {
    num: "1",
    title: "Anfrage & Erstgespräch",
    text: "Sie beschreiben kurz, welche Räume oder Gegenstände geräumt werden sollen.",
  },
  {
    num: "2",
    title: "Festpreis-Kalkulation",
    text: "Sie erhalten ein transparentes Festpreis-Angebot inklusive aller Entsorgungsgebühren.",
  },
  {
    num: "3",
    title: "Besenreine Übergabe",
    text: "Unser Team räumt pünktlich, transportiert alles ab und übergibt die Räume besenrein.",
  },
];

const benefits = [
  "Besenreine Übergabe garantiert",
  "Transparente Festpreise",
  "Fachgerechte & zertifizierte Entsorgung",
  "Schnelle Terminvereinbarung",
  "Diskrete & saubere Abwicklung",
  "Einsatz in ganz Landshut & Umland",
];

const meta = createSeoMetadata({
  title: "Entrümpelung Landshut » Schnell & Besenrein | Umzüge LAF",
  description:
    "Entrümpelung in Landshut mit Umzüge LAF: Wohnungsentrümpelung, Keller, Dachboden, Garage, Büro, Haushaltsauflösung und Sperrmüllentsorgung zum Festpreis.",
  path: "/entruempelung-landshut",
  keywords: [
    "Entrümpelung Landshut",
    "Entrümpelungsfirma Landshut",
    "Wohnungsentrümpelung Landshut",
    "Haushaltsauflösung Landshut",
    "Sperrmüllentsorgung Landshut",
  ],
  image: "https://umzuegelandshut.de/images/services/entruempelung.jpg",
});


---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.canonical}
  image={meta.image}
  noIndex={meta.noIndex}
>
  <main class="min-h-screen bg-white text-slate-900">
      <Header />

      <BreadcrumbJsonLd
        items={[
          { name: "Startseite", path: "/" },
          { name: "Entrümpelung Landshut", path: "/entruempelung-landshut" },
        ]}
      />

      <ServiceJsonLd
        name="Entrümpelung Landshut"
        description="Entrümpelung in Landshut mit Umzüge LAF: Wohnungsentrümpelung, Keller, Dachboden, Garage, Büro, Haushaltsauflösung und Sperrmüllentsorgung."
        path="/entruempelung-landshut"
        serviceType="Entrümpelung"
      />

      {/* ── HERO ── */}
      <section class="relative overflow-hidden bg-slate-950 pt-28 pb-16 text-white sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-28">
        <div class="absolute inset-0 z-0 opacity-60">
          <Image
            src="/images/services/entruempelung.jpg"
            alt="Umzüge LAF Entrümpelung Landshut"
            fill
            priority
            class="object-cover object-center sm:object-right"
          />
        </div>
        <div class="absolute inset-0 z-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/30 sm:to-transparent" />
        <div class="absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40" />

        <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            <Breadcrumbs
              items={[
                { label: "Leistungen", href: "/leistungen" },
                { label: "Entrümpelung Landshut" },
              ]}
            />

            <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-400/10 px-3.5 py-1.5 text-xs font-extrabold text-amber-300">
              <span>★ Besenrein & Fair ·</span>
              <span>Entrümpelung Landshut & Umgebung</span>
            </div>

            <h1 class="text-3xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.15]">
              Entrümpelung in Landshut.<br />
              <span class="text-amber-400">Schnell, diskret & besenrein.</span>
            </h1>

            <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
              Wohnungsauflösungen, Kellerentrümpelung, Haushaltsauflösung und Sperrmüll
              in Landshut. Wir räumen schnell, zuverlässig und hinterlassen alles sauber übergeben.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
              <a
                href={phoneHref}
                class="flex items-center justify-center gap-2.5 rounded-full bg-[#f59e0b] px-7 py-4 text-center text-base font-black text-slate-950 shadow-lg transition hover:bg-amber-400 active:scale-98"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
                  <path strokeLinecap="round" strokeLinejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>Direkt anrufen: {phone}</span>
              </a>

              <a
                href="#anfrage-formular"
                class="flex items-center justify-center rounded-full border-2 border-slate-600 bg-slate-800/80 px-7 py-4 text-center text-base font-bold text-white transition hover:border-slate-400 hover:bg-slate-700 active:scale-98"
              >
                Angebot anfordern →
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* ── ENTRÜMPELUNGS-SERVICES ── */}
      <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
              Unsere Leistungen
            </p>
            <h2 class="mt-2 text-2xl sm:text-4xl font-black tracking-tight text-slate-900">
              Räumung & Entsorgung für jeden Bedarf
            </h2>
          </div>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {clearingServices.map((service) => (
              <a
                key={service.href}
                href={service.href}
                class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm transition hover:border-amber-400 hover:bg-white hover:shadow-md"
              >
                <h3 class="text-lg font-black text-slate-900 group-hover:text-[#b45309]">
                  {service.title}
                </h3>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {service.text}
                </p>
                <p class="mt-4 text-xs font-extrabold text-[#b45309]">Mehr erfahren →</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* ── VORTEILE & ABLAUF ── */}
      <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
          <div>
            <p class="text-xs font-black uppercase tracking-widest text-[#b45309]">
              Ihre Vorteile
            </p>
            <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
              Zuverlässige Räumung ohne Stress
            </h2>

            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {benefits.map((item) => (
                <div key={item} class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm text-xs sm:text-sm font-bold text-slate-800">
                  <span class="text-amber-500 font-black">✓</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
            <h3 class="text-lg font-black text-slate-900">
              In 3 Schritten besenrein
            </h3>
            <div class="mt-6 grid gap-4">
              {process.map((p) => (
                <div key={p.title} class="flex gap-4">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-sm font-black text-amber-800">
                    {p.num}
                  </div>
                  <div>
                    <h4 class="text-sm font-black text-slate-900">{p.title}</h4>
                    <p class="mt-1 text-xs text-slate-600 leading-relaxed">{p.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ── ANFRAGE SEKTION ── */}
      <section id="anfrage-formular" class="py-16 sm:py-24 bg-slate-900 text-white scroll-mt-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-amber-400/10 px-3 py-1 text-xs font-bold text-amber-300">
                <span>📍</span>
                <span>Standort: Ergoldinger Str. 15, 84030 Landshut</span>
              </div>

              <h2 class="mt-4 text-3xl sm:text-4xl font-black text-white">
                Entrümpelung kostenlos anfragen
              </h2>

              <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
                Rufen Sie uns direkt an oder füllen Sie das kurze Formular aus. Wir
                erstellen Ihnen kurzfristig ein transparentes Festpreis-Angebot.
              </p>

              <div class="mt-6 rounded-2xl border border-slate-700 bg-slate-800/80 p-5">
                <p class="text-xs font-bold text-amber-400 uppercase tracking-wider">
                  Telefonische Beratung
                </p>
                <a
                  href={phoneHref}
                  class="mt-1 inline-flex items-center gap-2 text-xl font-black text-white hover:text-amber-400 transition"
                >
                  <span>📞</span>
                  <span>{phone}</span>
                </a>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-700 bg-white p-6 sm:p-8 text-slate-900 shadow-2xl">
              <h3 class="text-xl font-black text-slate-900">
                Online-Anfrage für Entrümpelung
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                In 2 Minuten ausgefüllt – 100% unverbindlich.
              </p>
              <div class="mt-5">
                <ContactForm client:visible />
              </div>
            </div>
          </div>
        </div>
      </section>

      <LocalSeoLinks />
      <Footer />
    </main>
</Layout>
