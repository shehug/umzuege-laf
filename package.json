{
  "name": "umzuege-laf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 3213",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && cp server.js dist/server.js && mkdir -p dist/nodejs && cp server.js dist/nodejs/server.js && node -e \"const fs=require('fs'); ['.next','out','build'].forEach(d => { if(!fs.existsSync(d)) fs.cpSync('dist', d, {recursive: true}); });\"",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 3213",
    "start": "node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.2.0",
    "@calcom/embed-react": "^1.5.3",
    "astro": "^5.4.0",
    "nodemailer": "^9.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
